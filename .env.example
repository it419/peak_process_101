# Copy to .env and fill in real values. Never commit .env.

# MySQL connection string used by Prisma.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Add "?sslaccept=strict" (or your provider's required SSL params) in production.
DATABASE_URL="mysql://root:password@localhost:3306/peak_process_onboarding"

# 32-byte (256-bit) key, base64-encoded, used for AES-256-GCM encryption of
# Aadhaar / PAN / UAN at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key without a re-encryption migration will make existing
# encrypted values unreadable — treat it like a production secret, back it up
# securely, and never reuse it across environments.
ENCRYPTION_KEY=""

# Name of the httpOnly cookie used to identify an onboarding session.
# Optional — defaults to "ppp_session" if unset.
SESSION_COOKIE_NAME="ppp_session"

# Name of the httpOnly cookie used for an HR/Admin login session.
# Optional — defaults to "ppp_admin_session" if unset.
ADMIN_SESSION_COOKIE_NAME="ppp_admin_session"

# The one HR/Admin account is provisioned by `npm run db:seed` from these two
# vars (there is no signup page). Leave both unset to skip seeding an admin.
# Re-running the seed with a changed password updates the existing account.
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# Object storage for resumes/application documents — an S3-compatible
# endpoint (e.g. a self-hosted MinIO instance). MINIO_ENDPOINT is the host
# only, no scheme (an "https://" prefix is added automatically).
MINIO_ENDPOINT=""
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET=""
